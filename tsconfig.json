{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["vite/client"],
    "outDir": "dist",
    "rootDir": ".",
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": ["src", "tests", "tools", "server", "vite.config.ts", "playwright.config.ts"]
}
