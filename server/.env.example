# MiniGames server — copy to .env and fill locally. NEVER commit real secrets.
# All values are optional; FileStore is used when DATABASE_URL is empty.

# PostgreSQL (production/staging). Leave empty for local FileStore preview.
# DATABASE_URL=postgres://minigames:change-me@127.0.0.1:5432/minigames
# PG_URL=            # alias accepted instead of DATABASE_URL

# Local preview data directory (FileStore).
DATA_DIR=./server-data

# Port for the local server (127.0.0.1 bind).
PORT=8099

# Expose OTP codes in API responses. TEST ONLY — never set in production.
MG_TEST_HOOKS=0

# Mailer transport (production OTP delivery). Not implemented yet: leaving this
# empty means production login is intentionally BLOCKED, never faked.
# MAIL_URL=
# MAIL_FROM=no-reply@example.com
